{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FACET",
  "version": "1.2.0",
  "identifier": "hu.bench.facet",
  "build": {
    "frontendDist": "./loader"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "BBencht",
    "copyright": "© 2026 BBencht",
    "shortDescription": "FACET — IDE, ami átalakul a fájl típusához",
    "longDescription": "FACET: fejlesztői környezet Java-, Python- és webfejlesztéshez. A felület a megnyitott fájl típusához igazodik; Hibatolmács, Git-térkép, UML-export, élő előnézet és mini Word egy helyen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "res/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "default-jdk | openjdk-21-jdk | openjdk-17-jdk"
        ]
      }
    }
  }
}
